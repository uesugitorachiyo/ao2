{
  "name": "ao2",
  "private": false,
  "version": "0.4.80",
  "description": "Local-first governed software-delivery orchestration.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "cargo build --workspace",
    "build:release": "cargo build --release -p ao2-cli",
    "package:local": "node scripts/run-release-ao2.js release package --out-dir dist",
    "package:linux:aarch64:docker": "node scripts/run-sh-script.js scripts/package-linux-aarch64-docker.sh",
    "package:linux:x86_64:docker": "node scripts/run-sh-script.js scripts/package-linux-x86_64-docker.sh",
    "package:windows:x86_64:docker": "node scripts/run-sh-script.js scripts/package-windows-x86_64-docker.sh",
    "release:build-all": "node scripts/run-sh-script.js scripts/release-build-all.sh",
    "release:sign-provenance": "node scripts/run-sh-script.js scripts/release-sign-provenance.sh",
    "release:verify-provenance": "node scripts/run-sh-script.js scripts/release-verify-provenance.sh",
    "release:gate": "node scripts/run-sh-script.js scripts/release-gate.sh",
    "release:retention-preflight": "node scripts/run-sh-script.js scripts/release-retention-preflight.sh",
    "release:download-verify": "node scripts/run-sh-script.js scripts/release-download-verify.sh",
    "release:preserve-provider-acceptance": "node scripts/run-sh-script.js scripts/preserve-provider-pilot-acceptance.sh",
    "phase1:replacement-promotion": "node scripts/run-sh-script.js scripts/phase1-replacement-promotion.sh",
    "phase1:prepare-prerequisites": "python3 scripts/prepare_phase1_promotion_prerequisites.py",
    "phase1:promote": "node scripts/run-sh-script.js scripts/phase1-prepare-preflight-publish.sh",
    "phase1:dashboard-snapshot": "node scripts/run-sh-script.js scripts/phase1-control-plane-dashboard-snapshot.sh",
    "phase1:evidence-bundle-verify": "node scripts/run-sh-script.js scripts/verify-phase1-evidence-bundle.sh",
    "phase1:promotion-status": "node scripts/run-release-ao2.js release phase1-promotion-status",
    "release:ship": "node scripts/run-sh-script.js scripts/release-ship.sh",
    "smoke:three-os": "node scripts/run-sh-script.js scripts/smoke-three-os-release.sh",
    "smoke:workbench-release-comparison-export": "node scripts/run-sh-script.js scripts/smoke-workbench-release-comparison-export.sh",
    "smoke:workbench-provider-pilot-acceptance-export": "node scripts/run-sh-script.js scripts/smoke-workbench-provider-pilot-acceptance-export.sh",
    "smoke:phase1-control-plane-readback": "node scripts/run-sh-script.js scripts/smoke-phase1-control-plane-readback.sh",
    "smoke:factory-greenfield-run": "node scripts/run-sh-script.js scripts/smoke-factory-greenfield-run.sh",
    "smoke:factory-app-run": "node scripts/run-sh-script.js scripts/smoke-factory-app-run.sh",
    "smoke:factory-project-run": "node scripts/run-sh-script.js scripts/smoke-factory-project-run.sh",
    "parity:factory-v3": "node scripts/run-sh-script.js scripts/factory-v3-parity-oracle.sh",
    "provider-readiness:build": "node scripts/run-sh-script.js scripts/build-provider-readiness.sh",
    "provider-readiness:publish": "node scripts/run-sh-script.js scripts/publish-provider-readiness.sh",
    "smoke:provider:codex": "node scripts/run-sh-script.js scripts/smoke-codex-provider.sh",
    "smoke:provider:codex-pilot": "node scripts/run-sh-script.js scripts/smoke-codex-provider-pilot.sh",
    "smoke:provider:claude": "node scripts/run-sh-script.js scripts/smoke-claude-provider.sh",
    "smoke:provider:claude-pilot": "node scripts/run-sh-script.js scripts/smoke-claude-provider-pilot.sh",
    "smoke:provider:antigravity-pilot": "node scripts/run-sh-script.js scripts/smoke-antigravity-provider-pilot.sh",
    "risky-pr:golden": "node scripts/run-sh-script.js scripts/risky-pr-golden-path.sh",
    "smoke:evidence-control-plane": "node scripts/run-sh-script.js scripts/smoke-evidence-pack-control-plane.sh",
    "release:readiness": "node scripts/run-sh-script.js scripts/release-readiness.sh",
    "release:readiness:static": "node scripts/run-sh-script.js scripts/release-readiness.sh --static-only",
    "release:readiness:full": "node scripts/run-sh-script.js scripts/release-readiness.sh --full",
    "ci:license-provenance": "node scripts/run-sh-script.js scripts/license-provenance-gate.sh",
    "ci:local": "node scripts/run-sh-script.js scripts/local-ci.sh",
    "verify": "cargo fmt --all -- --check && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings",
    "verify:replacement": "node scripts/run-sh-script.js scripts/verify-replacement-parity.sh",
    "verify:no-factory-v3": "node scripts/run-sh-script.js scripts/verify-no-factory-v3-green-path.sh",
    "gate:full": "node scripts/run-sh-script.js scripts/gate-with-replacement.sh"
  }
}
