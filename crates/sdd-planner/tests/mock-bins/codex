#!/usr/bin/env bash
# Portable env-var-driven mock for the codex CLI.
#
# Variables (all optional):
#   SDD_MOCK_CAPTURE   path to write stdin envelope to (for inspection)
#   SDD_MOCK_STDOUT    path of file to print to stdout
#   SDD_MOCK_EXIT      exit code (default: 0)
#   SDD_MOCK_BAD_JSON  if "1", emit non-JSON garbage to stdout
#
# Defaults: drain stdin silently, print nothing, exit 0.

set -euo pipefail

if [ -n "${SDD_MOCK_CAPTURE:-}" ]; then
    cat > "$SDD_MOCK_CAPTURE"
else
    cat >/dev/null
fi

if [ "${SDD_MOCK_BAD_JSON:-0}" = "1" ]; then
    printf 'this is not JSON, sorry\n'
    exit "${SDD_MOCK_EXIT:-0}"
fi

if [ -n "${SDD_MOCK_STDOUT:-}" ]; then
    cat "$SDD_MOCK_STDOUT"
fi

exit "${SDD_MOCK_EXIT:-0}"
