{
  "schema_version": "ao2.public-export-manifest.v1",
  "repo": "ao2",
  "source": {
    "repo": "ao2",
    "code_export_baseline_commit": "165e9b3510a088ef2c14324ef67e0eb0eeb43085",
    "execution_commit": "ab700c1af8c568f87e5bf7c5bd5ac1ae4103c9a7"
  },
  "destination": "ao-public-repos/ao2",
  "strategy": "clean-copy-no-private-history",
  "public_role": "primary local-first governed software-delivery repo",
  "include": [
    "Cargo.toml",
    "Cargo.lock",
    "package.json",
    "pnpm-workspace.yaml",
    "rust-toolchain.toml",
    "deny.toml",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "README.md",
    "CODEOWNERS.md",
    ".github/workflows/ci.yml",
    ".github/workflows/release-gate.yml",
    ".github/workflows/windows-release-smoke.yml",
    "crates/",
    "schemas/",
    "examples/",
    "fixtures/",
    "packages/",
    "scripts/",
    "docs/ARCHITECTURE.md",
    "docs/INSTALL.md",
    "docs/PRD.md",
    "docs/SDD-risky-pr-run.md",
    "docs/SCHEMAS-AND-INTERFACES.md",
    "docs/IMPLEMENTATION-SLICES.md",
    "docs/SECURITY.md",
    "docs/VERIFICATION.md",
    "docs/THIRD-PARTY-LICENSES.md",
    "docs/contracts/"
  ],
  "exclude": [
    ".git/",
    ".ao2/",
    ".release-signing/",
    ".gstack/",
    ".claude/",
    ".pytest_cache/",
    ".DS_Store",
    "target/",
    "dist/",
    "dist-*/",
    "dist-provenance/",
    "docs/status/",
    "docs/superpowers/",
    "docs/AGENT-COORDINATION.md",
    "docs/NEXT-ACTIONS.md",
    "docs/REPOSITORY-STRUCTURE.md",
    "docs/RELEASE-INSTALL-SMOKE.md",
    "docs/PHASE-1-ACCEPTANCE.md",
    ".github/workflows/private-release-build.yml",
    "private coordination logs",
    "private handoff artifacts",
    "generated runtime evidence",
    "release signing private keys",
    "local absolute paths"
  ],
  "trust_boundary": {
    "provider_api_key_auth": "forbidden",
    "control_plane_role": "external read_only_observer",
    "mutates_control_plane": false
  }
}
